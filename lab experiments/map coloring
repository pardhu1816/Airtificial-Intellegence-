def is_safe(node, graph, color, c):
    for neighbor in range(len(graph)):
        if graph[node][neighbor] == 1 and color[neighbor] == c:
            return False
    return True

def graph_coloring_util(graph, num_colors, color, node):
    if node == len(graph):
        return True

    for c in range(1, num_colors + 1):
        if is_safe(node, graph, color, c):
            color[node] = c
            
            if graph_coloring_util(graph, num_colors, color, node + 1):
                return True
                
            color[node] = 0

    return False

def graph_coloring(graph, num_colors):
    num_nodes = len(graph)
    color = [0] * num_nodes

    if not graph_coloring_util(graph, num_colors, color, 0):
        return False

    return color
