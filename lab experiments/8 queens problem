def is_safe(board, row, col):
    for r in range(row):
        c = board[r]
        if c == col or abs(c - col) == abs(r - row):
            return False
    return True

def solve_queens(board, row):
    if row == 8:
        return True

    for col in range(8):
        if is_safe(board, row, col):
            board[row] = col
            if solve_queens(board, row + 1):
                return True
            board[row] = -1

    return False

# Execute
board = [-1] * 8
if solve_queens(board, 0):
    print("--- 8-QUEENS SOLUTION ---")
    for col in board:
        row_str = ["."] * 8
        row_str[col] = "Q"
        print(" ".join(row_str))
