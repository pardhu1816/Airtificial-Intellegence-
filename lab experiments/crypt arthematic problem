import itertools

def solve_crypt():
    letters = "SENDMOREMONEY"
    unique = list(set(letters))
    
    for perm in itertools.permutations(range(10), len(unique)):
        d = dict(zip(unique, perm))
        
        # Leading digits cannot be 0
        if d['S'] == 0 or d['M'] == 0:
            continue
            
        send = d['S']*1000 + d['E']*100 + d['N']*10 + d['D']
        more = d['M']*1000 + d['O']*100 + d['R']*10 + d['E']
        money = d['M']*10000 + d['O']*1000 + d['N']*100 + d['E']*10 + d['Y']
        
        if send + more == money:
            print(f"  {send}\n+ {more}\n= {money}")
            return

# Run
solve_crypt()
