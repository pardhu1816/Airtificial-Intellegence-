from collections import deque

START = (3, 3, 1)
GOAL = (0, 0, 0)

def is_valid(m, c):
   
    if m < 0 or m > 3 or c < 0 or c > 3:
        return False
  
    if (m > 0 and c > m) or (3 - m > 0 and 3 - c > 3 - m):
        return False
    return True

def solve_missionaries_cannibals():
    queue = deque([(START, [START])])
    visited = {START}

    # Possible boat moves (M, C)
    moves = [(1, 0), (2, 0), (0, 1), (0, 2), (1, 1)]

    while queue:
        (m, c, boat), path = queue.popleft()

        if (m, c, boat) == GOAL:
            return path

        for dm, dc in moves:
            # Move boat from Left to Right (-1) or Right to Left (+1)
            direction = -1 if boat == 1 else 1
            new_m = m + direction * dm
            new_c = c + direction * dc
            new_boat = 1 - boat

            if is_valid(new_m, new_c):
                new_state = (new_m, new_c, new_boat)
                if new_state not in visited:
                    visited.add(new_state)
                    queue.append((new_state, path + [new_state]))

# Run
path = solve_missionaries_cannibals()
print("--- MISSIONARIES & CANNIBALS SOLUTION ---")
for step, (m, c, b) in enumerate(path):
    bank = "Left" if b == 1 else "Right"
    print(f"Step {step}: Left Bank -> {m}M, {c}C | Boat is on {bank}")
